rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /records/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /rankStats/{id} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
