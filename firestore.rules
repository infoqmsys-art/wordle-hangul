rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /records/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll([
          'name', 'word', 'seconds', 'attempts', 'maxAttempts', 'won', 'dateKey', 'savedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.word is string
        && request.resource.data.word.size() > 0
        && request.resource.data.word.size() <= 20
        && request.resource.data.seconds is number
        && request.resource.data.attempts is number
        && request.resource.data.maxAttempts is number
        && request.resource.data.won is bool;
      allow update, delete: if false;
    }
  }
}
